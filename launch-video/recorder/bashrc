export LANG=C.UTF-8 LC_ALL=C.UTF-8  # readline must count the prompt glyph as one column
PS1='\[\e[38;2;91;95;232m\]❯\[\e[0m\] '
export npm_config_fund=false npm_config_audit=false npm_config_update_notifier=false
export VIRTUAL_ENV_DISABLE_PROMPT=1 PIP_DISABLE_PIP_VERSION_CHECK=1
cd "$RECORD_DIR/snapkit-checkout" 2>/dev/null || true
